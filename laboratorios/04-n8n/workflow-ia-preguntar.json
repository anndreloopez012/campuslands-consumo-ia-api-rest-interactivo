      ],
      "webhookId": "ia-preguntar"
    },
    {
      "parameters": {
        "jsCode": "// Valida la entrada antes de gastar tokens.\nconst entrada = $input.first().json.body ?? {};\nconst pregunta = entrada.pregunta;\n\nif (typeof pregunta !== \"string\" || !pregunta.trim() || pregunta.length > 2000) {\n  return [{ json: { valido: false, error: \"La pregunta es obligatoria, debe ser texto y tener máximo 2000 caracteres\" } }];\n}\n\nreturn [{ json: { valido: true, pregunta: pregunta.trim() } }];"
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Validación",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.valido }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "¿Pregunta válida?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/responses",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: \"gpt-6-luna\", instructions: \"Eres un tutor de IA. Responde en español.\", input: $json.pregunta, max_output_tokens: 500 } }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
