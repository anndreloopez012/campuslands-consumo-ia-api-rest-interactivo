          "name": "OpenAI Header Auth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Simplifica la respuesta del proveedor para el cliente.\nconst data = $input.first().json;\n\nif (data.status !== \"completed\") {\n  throw new Error(\"Respuesta incompleta del modelo\");\n}\n\nconst textos = (data.output ?? [])\n  .filter(item => item.type === \"message\")\n  .flatMap(item => item.content ?? [])\n  .filter(item => item.type === \"output_text\")\n  .map(item => item.text ?? \"\");\n\nreturn [{\n  json: {\n    respuesta: textos.join(\"\\n\").trim(),\n    modelo: data.model,\n    tokens: data.usage?.total_tokens ?? null\n  }\n}];"
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Transformar respuesta",
      "type": "n8n-nodes-base.code",
